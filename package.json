{
  "name": "metathreadscountryinfo",
  "version": "1.0.0",
  "description": "Threads 帳號地點、加入時間與標記工具，提供 Chrome／Firefox 擴充功能與 Violentmonkey userscript。",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "bash scripts/generate-icons.sh",
    "download:world": "node scripts/download-world.cjs",
    "generate:mapper": "node scripts/generate-location-mapper.cjs",
    "prebuild": "npm run generate:mapper",
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "build:firefox-amo": "FIREFOX_BUILD_TYPE=amo node esbuild.config.js",
    "build:firefox-self-hosted": "FIREFOX_BUILD_TYPE=self-hosted node esbuild.config.js",
    "clean": "rm -rf dist",
    "start:firefox": "web-ext run --source-dir=dist/firefox --start-url=https://www.threads.com",
    "check:versions": "node scripts/check-versions.js",
    "prebuild:userscript": "npm run generate:mapper",
    "build:userscript": "node esbuild.config.js --userscript"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echoapus/lee-su-threads.git"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.27.1",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.15",
    "web-ext": "^9.2.0"
  },
  "dependencies": {
    "country-flag-emoji-polyfill": "^0.1.8"
  }
}
